---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { research, url } from '../../lib/site';
export async function getStaticPaths() {
  return (await research()).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'research'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Layout title={entry.data.title} description={entry.data.description} active="Research">
  <div class="article-topline"><a href={url('research/')}>← Research</a><span>{entry.data.type}{entry.data.year ? ` · ${entry.data.year}` : ''}</span></div>
  <article class="paper">
    <header class="paper-heading">
      {entry.data.example && <p class="example-label">Example entry · replace with your work</p>}
      <h1>{entry.data.title}</h1>
      {entry.data.description && <p>{entry.data.description}</p>}
    </header>
    <div class="prose"><Content /></div>
  </article>
  <div class="article-bottom"><a href={url('research/')}>← All research</a><a href="#main">Back to top ↑</a></div>
</Layout>
